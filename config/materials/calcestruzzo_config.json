    "norme": [
        {
            "key": "NTC2018",
            "label": "NTC 2018 (D.M. 17/01/2018)",
            "attiva": true,
            "parametri_specifici": {
                "gamma_c": {
                    "valore": 1.50,
                    "label": "γ_c",
                    "unita": "-",
                    "descrizione": "Coeff. di sicurezza calcestruzzo (SLU)"
                },
                "alpha_cc": {
                    "valore": 0.85,
                    "label": "α_cc",
                    "unita": "-",
                    "descrizione": "Coeff. effetti lungo termine (NTC2018 §4.1.2.1.1.5)"
                }
            },
            "parametri_input": [
                {
                    "key": "f_ck",
                    "label": "f_ck",
                    "unita": "kg/cm²",
                    "tipo": "float",
                    "default": 254.9,
                    "obbligatorio": true,
                    "gruppo": "resistenze",
                    "descrizione": "Resistenza caratteristica cilindrica (principale)"
                },
                {
                    "key": "densita_kg_m3",
                    "label": "Densità",
                    "unita": "kg/m³",
                    "tipo": "float",
                    "default": 2500,
                    "obbligatorio": false,
                    "gruppo": "generali"
                },
                {
                    "key": "nu",
                    "label": "ν",
                    "unita": "-",
                    "tipo": "float",
                    "default": 0.20,
                    "obbligatorio": false,
                    "gruppo": "meccanici",
                    "descrizione": "Coefficiente di Poisson"
                }
            ],
            "parametri_derivati": [
                {
                    "key": "f_cm",
                    "label": "f_cm",
                    "unita": "kg/cm²",
                    "formula": "f_ck + 81.6",
                    "gruppo": "resistenze",
                    "descrizione": "Resistenza media cilindrica (f_ck + 8 MPa)"
                },
                {
                    "key": "E",
                    "label": "E",
                    "unita": "kg/cm²",
                    "formula": "22000 * pow((f_ck / 10.197 + 8.0) / 10.0, 0.3) * 10.197",
                    "gruppo": "meccanici",
                    "descrizione": "Modulo elastico Ecm (NTC2018 Tab.11.2.IV)"
                },
                {
                    "key": "G",
                    "label": "G",
                    "unita": "kg/cm²",
                    "formula": "E / (2.0 * (1.0 + nu))",
                    "gruppo": "meccanici",
                    "descrizione": "Modulo di taglio"
                },
                {
                    "key": "f_ctm",
                    "label": "f_ctm",
                    "unita": "kg/cm²",
                    "formula": "0.30 * pow(f_ck / 10.197, 2.0/3.0) * 10.197",
                    "gruppo": "resistenze",
                    "descrizione": "Resistenza media a trazione"
                },
                {
                    "key": "f_ctk005",
                    "label": "f_ctk,0.05",
                    "unita": "kg/cm²",
                    "formula": "0.7 * f_ctm",
                    "gruppo": "resistenze",
                    "descrizione": "Resistenza caratteristica a trazione (frattile 5%)"
                },
                {
                    "key": "f_ctk095",
                    "label": "f_ctk,0.95",
                    "unita": "kg/cm²",
                    "formula": "1.3 * f_ctm",
                    "gruppo": "resistenze",
                    "descrizione": "Resistenza caratteristica a trazione (frattile 95%)"
                },
                {
                    "key": "f_cd",
                    "label": "f_cd",
                    "unita": "kg/cm²",
                    "formula": "alpha_cc * f_ck / gamma_c",
                    "gruppo": "resistenze",
                    "descrizione": "Resistenza di progetto a compressione (SLU)"
                },
                {
                    "key": "f_ctd",
                    "label": "f_ctd",
                    "unita": "kg/cm²",
                    "formula": "f_ctk005 / gamma_c",
                    "gruppo": "resistenze",
                    "descrizione": "Resistenza di progetto a trazione (SLU)"
                },
                {
                    "key": "eps_cu",
                    "label": "ε_cu",
                    "unita": "-",
                    "formula": "0.0035 if f_ck <= 509.8 else (2.6 + 35.0 * pow((0.09 - f_ck / 10197.0), 4.0)) / 1000.0",
                    "gruppo": "meccanici",
                    "descrizione": "Deformazione ultima a compressione"
                }
            ]
        },
