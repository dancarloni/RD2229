    "norme": [
        {
            "key": "NTC2018",
            "label": "NTC 2018 (D.M. 17/01/2018)",
            "attiva": true,
            "parametri_specifici": {
                "gamma_s": {
                    "valore": 1.15,
                    "label": "γ_s",
                    "unita": "-",
                    "descrizione": "Coeff. di sicurezza acciaio (SLU)"
                }
            },
            "parametri_input": [
                {
                    "key": "f_yk",
                    "label": "f_yk",
                    "unita": "kg/cm²",
                    "tipo": "float",
                    "default": 4589.0,
                    "obbligatorio": true,
                    "gruppo": "resistenze",
                    "descrizione": "Tensione di snervamento caratteristica"
                },
                {
                    "key": "f_uk",
                    "label": "f_uk",
                    "unita": "kg/cm²",
                    "tipo": "float",
                    "default": 5403.0,
                    "obbligatorio": false,
                    "gruppo": "resistenze",
                    "descrizione": "Tensione di rottura caratteristica"
                },
                {
                    "key": "densita_kg_m3",
                    "label": "Densità",
                    "unita": "kg/m³",
                    "tipo": "float",
                    "default": 7850.0,
                    "obbligatorio": false,
                    "gruppo": "generali"
                },
                {
                    "key": "nu",
                    "label": "ν",
                    "unita": "-",
                    "tipo": "float",
                    "default": 0.30,
                    "obbligatorio": false,
                    "gruppo": "meccanici"
                }
            ],
            "parametri_derivati": [
                {
                    "key": "f_yd",
                    "label": "f_yd",
                    "unita": "kg/cm²",
                    "formula": "f_yk / gamma_s",
                    "formula_latex": "$f_{yd} = \\frac{f_{yk}}{\\gamma_s}\\;[\\S4.2.4.1.2]$",
                    "formula_html": "f<sub>yd</sub> = f<sub>yk</sub> / γ<sub>s</sub>",
                    "rif_norm": "§4.2.4.1.2 NTC2018",
                    "gruppo": "resistenze",
                    "descrizione": "Resist. di progetto a snervamento (SLU)"
                },
                {
                    "key": "E",
                    "label": "E",
                    "unita": "kg/cm²",
                    "formula": "2060000.0",
                    "formula_latex": "$E_s = 206\\,000\\,\\mathrm{MPa} = 2\\,060\\,000\\,\\mathrm{kg/cm^2}$",
                    "formula_html": "E<sub>s</sub> = 206 000 MPa = 2 060 000 kg/cm² (costante)",
                    "rif_norm": "§11.3.2 NTC2018",
                    "gruppo": "meccanici",
                    "descrizione": "Modulo di Young (costante per acciaio)"
                },
                {
                    "key": "G",
                    "label": "G",
                    "unita": "kg/cm²",
                    "formula": "E / (2.0 * (1.0 + nu))",
                    "formula_latex": "$G = \\frac{E}{2\\,(1+\\nu)} \\approx \\frac{E}{2.6}$",
                    "formula_html": "G = E / (2·(1+ν)) ≈ E / 2.6",
                    "rif_norm": "—",
                    "gruppo": "meccanici"
                }
            ]
        },
