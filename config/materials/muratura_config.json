                    "obbligatorio": true,
                    "gruppo": "resistenze",
                    "descrizione": "Resist. caratt. a compressione della muratura (principale)"
                },
                {
                    "key": "f_vk0",
                    "label": "f_vk0",
                    "unita": "kg/cm²",
                    "tipo": "float",
